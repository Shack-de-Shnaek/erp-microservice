        <mxCell id="Kex4wcxGBSkoDXFyb8dY-201" edge="1" parent="1" source="Kex4wcxGBSkoDXFyb8dY-178" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=1 3;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;strokeColor=#666666;" target="Kex4wcxGBSkoDXFyb8dY-180" value="client_credentials (erp-orders)&#xa;+ JWKS validation">
