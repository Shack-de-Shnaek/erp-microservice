        <mxCell id="Kex4wcxGBSkoDXFyb8dY-174" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;MCP client (LLM host)&lt;/b&gt;&lt;br&gt;Claude Desktop · LM Studio · opencode&lt;br&gt;terminal client" vertex="1">
          <mxGeometry height="90" width="260" x="2594" y="802.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-175" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;MCP Server&lt;/b&gt; :8765&lt;br&gt;Python · FastMCP&lt;br&gt;stdio (default) or streamable-HTTP /mcp&lt;br&gt;7 inventory read tools, 5 order read tools,&lt;br&gt;9 write tools (ERP_ENABLE_WRITES)" vertex="1">
          <mxGeometry height="110" width="330" x="2564" y="937.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-176" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;API Gateway&lt;/b&gt; :8088  (Spring Cloud Gateway, WebFlux)&lt;br&gt;• oauth2Login (browser) + JWT resource server (API) + TokenRelay filter&lt;br&gt;• /api/inventory/** → lb://inventory /api/**   • /api/orders/** → lb://orders /orders/**, /invoices/**&lt;br&gt;• /docs/&amp;lt;service&amp;gt;/** → proxied OpenAPI + AsyncAPI documents  • serves the aggregated Swagger UI" vertex="1">
          <mxGeometry height="120" width="700" x="1704" y="1007.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-177" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Consul&lt;/b&gt; :8500&lt;br&gt;Service registry&lt;br&gt;+ health checks&lt;br&gt;(lb:// resolution,&lt;br&gt;Feign load balancing)" vertex="1">
          <mxGeometry height="150" width="190" x="1424" y="1267.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-178" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Order Service&lt;/b&gt; :8089  (`orders`)&lt;br&gt;Spring Boot · Kotlin · Axon&lt;br&gt;• Aggregate: Order (create, amend, approve,&lt;br&gt;   reject, cancel, payments, invoice, reversal)&lt;br&gt;• CQRS: commands → event store, JPA read model&lt;br&gt;• OpenFeign + Resilience4j → inventory&lt;br&gt;• springdoc OpenAPI + springwolf AsyncAPI" vertex="1">
          <mxGeometry height="190" width="350" x="1694" y="1227.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-179" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Inventory Service&lt;/b&gt; :8081  (`inventory`)&lt;br&gt;Spring Boot · Kotlin · Axon&lt;br&gt;• Aggregates: Product, StockItem&lt;br&gt;• Reservations: hold / amend / release / confirm&lt;br&gt;• OrderLifecycleSaga, ActiveProductReservationPolicy&lt;br&gt;• Read models: catalogue, stock, low-stock, summary&lt;br&gt;• springdoc OpenAPI + springwolf AsyncAPI" vertex="1">
          <mxGeometry height="190" width="350" x="2114" y="1227.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-180" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Keycloak&lt;/b&gt; :8080&lt;br&gt;&lt;i&gt;Identity provider (external integration)&lt;/i&gt;&lt;br&gt;Realm &lt;b&gt;erp&lt;/b&gt; — OIDC / JWT, JWKS&lt;br&gt;• erp-gateway — authorization code (browser)&lt;br&gt;• erp-orders — client credentials (SERVICE)&lt;br&gt;• erp-mcp — client credentials (ADMIN+CUSTOMER)&lt;br&gt;Roles: ADMIN · CUSTOMER · SERVICE" vertex="1">
          <mxGeometry height="190" width="330" x="2620" y="1227.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-181" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef7ea;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=middle;fontSize=10;dashed=1;" value="&lt;b&gt;orders ↔ Kafka&lt;/b&gt;  (`infrastructure.kafka`, the only package here that names Kafka)&lt;br&gt;&lt;b&gt;out ↓&lt;/b&gt; `EventMessagingEventHandler` on the Axon tracking processor `event-messaging` — one&lt;br&gt;    `@EventHandler(AbstractEvent)` asks every event `toExternalEvents()`; topic is derived from the&lt;br&gt;    class name (`OrderApprovedEvent` → `order.approved`), key = orderId&lt;br&gt;&lt;b&gt;in ↑&lt;/b&gt; `KafkaEventConsumer` `@KafkaListener` (group `orders-group`) → translator → handler → &lt;b&gt;CommandGateway&lt;/b&gt;:&lt;br&gt;   • `stock.confirmed` → &lt;b&gt;ApproveOrderForConfirmedStockCommand&lt;/b&gt;&lt;br&gt;   • `stock.reservation.released` / `stock.returned` → &lt;b&gt;RejectOrderForWithdrawnStockCommand&lt;/b&gt;&lt;br&gt;      (only when the reason is WITHDRAWN_BY_INVENTORY — a release we asked for is dropped)&lt;br&gt;   • `product.deactivated` → &lt;b&gt;RejectOrderCommand&lt;/b&gt; for every PENDING order holding that product" vertex="1">
          <mxGeometry height="185" width="390" x="1664" y="1467.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-182" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef7ea;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=middle;fontSize=10;dashed=1;" value="&lt;b&gt;inventory ↔ Kafka&lt;/b&gt;  (`infrastructure.kafka`)&lt;br&gt;&lt;b&gt;out ↓&lt;/b&gt; `EventMessagingEventHandler` asks every `AbstractEvent` `toExternalEvent()`; topic derived the&lt;br&gt;    same way (`StockConfirmedEvent` → `stock.confirmed`), key = productId / stockItemId&lt;br&gt;&lt;b&gt;in ↑&lt;/b&gt; `KafkaEventConsumer` `@KafkaListener` (group `inventory-group`) → `OrderEventTranslator` →&lt;br&gt;    `OrderLifecycleSaga` → &lt;b&gt;CommandGateway&lt;/b&gt;:&lt;br&gt;   • `order.nullified` → &lt;b&gt;ReleaseReservationCommand&lt;/b&gt;(reason ORDER_NULLIFIED), one per line&lt;br&gt;      actually held — the lines come from this service&#39;s reservation view, not from the message&lt;br&gt;&lt;i&gt;`order.created` / `order.approved` are deliberately not consumed: stock is taken by the&lt;br&gt;synchronous reservation call, so approval is now a consequence of &lt;b&gt;this&lt;/b&gt; service confirming.&lt;/i&gt;" vertex="1">
          <mxGeometry height="185" width="390" x="2104" y="1467.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-183" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;" value="&lt;b&gt;Apache Kafka (KRaft, single broker `broker`)&lt;/b&gt; :9092 — the asynchronous backbone  ·  1 partition / 1 replica per topic, `acks=all`, `auto-offset-reset=earliest`, durable log on a named volume&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;JSON payloads, String key/value serializers. Each message carries `_eventType` as its envelope. Topics a service &lt;i&gt;consumes&lt;/i&gt; are declared by `KafkaTopicsConfig` so a cold start does not wait out a metadata refresh; topics it &lt;i&gt;publishes&lt;/i&gt; are auto-created on first send.&lt;/font&gt;" vertex="1">
          <mxGeometry height="457.8" width="870" x="1644" y="1692.2" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-184" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;fontSize=10;" value="&lt;b&gt;Published by orders&lt;/b&gt;  (key = orderId)&lt;br&gt;&lt;br&gt;&lt;b&gt;order.nullified&lt;/b&gt; — all three endings in one topic:&lt;br&gt;   CANCELLED · REJECTED · REFUNDED&lt;br&gt;order.created · order.approved · order.cancelled&lt;br&gt;invoice.generated · invoice.reversed" vertex="1">
          <mxGeometry height="110" width="400" x="1669" y="1779.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-185" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;fontSize=10;" value="&lt;b&gt;Published by inventory&lt;/b&gt;  (key = productId / stockItemId)&lt;br&gt;&lt;br&gt;product.created · product.updated&lt;br&gt;product.deactivated · product.reactivated&lt;br&gt;stock.reserved · stock.reservation.amended · stock.adjusted&lt;br&gt;stock.reservation.released · stock.returned · stock.confirmed" vertex="1">
          <mxGeometry height="110" width="400" x="2089" y="1779.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-186" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef7ea;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;fontSize=10;" value="&lt;b&gt;Consumed by orders&lt;/b&gt;  (group `orders-group`)&lt;br&gt;&lt;br&gt;&lt;b&gt;stock.confirmed&lt;/b&gt; → approves the order&lt;br&gt;&lt;b&gt;stock.reservation.released&lt;/b&gt; · &lt;b&gt;stock.returned&lt;/b&gt; → may reject it&lt;br&gt;&lt;b&gt;product.deactivated&lt;/b&gt; → rejects every pending order&lt;br&gt;   holding that product&lt;br&gt;&lt;i&gt;Nothing else inventory publishes is read here.&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="400" x="1669" y="1904.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-187" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef7ea;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;fontSize=10;" value="&lt;b&gt;Consumed by inventory&lt;/b&gt;  (group `inventory-group`)&lt;br&gt;&lt;br&gt;&lt;b&gt;order.nullified&lt;/b&gt; → releases the hold, one line at a time&lt;br&gt;&lt;br&gt;&lt;i&gt;order.created / order.approved are deliberately not read: stock is taken by the synchronous reservation call, so approval is this service&#39;s own doing coming back to it.&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="400" x="2089" y="1904.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-188" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=middle;fontSize=10;" value="&lt;b&gt;Events travel on Kafka; commands do not.&lt;/b&gt;  No topic carries a command, and no service dispatches a command into another service&#39;s aggregate. The one cross-service &lt;i&gt;command&lt;/i&gt; — taking stock for an order — goes &lt;b&gt;synchronously over REST&lt;/b&gt; (`POST /api/reservations`), because the customer is told &quot;order placed&quot; on the strength of the answer and that promise must not rest on a message still in flight. Giving stock back, and everything else, is &lt;b&gt;asynchronous&lt;/b&gt;: nobody waits on it and it must happen even if the other side cannot ask. A consumed event turns into a command only &lt;i&gt;inside&lt;/i&gt; the receiving service, on its own in-process Axon command bus — the green arrows above." vertex="1">
          <mxGeometry height="75" width="820" x="1669" y="2039.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-189" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;" value="&lt;b&gt;PostgreSQL&lt;/b&gt; :5432 — one instance, three logical databases (persistent volume)" vertex="1">
          <mxGeometry height="160" width="770" x="1694" y="2319.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-190" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;" value="&lt;b&gt;orders&lt;/b&gt;&lt;br&gt;Axon JPA event store&lt;br&gt;+ order/invoice read model&lt;br&gt;+ tracking-processor tokens" vertex="1">
          <mxGeometry height="90" width="210" x="1724" y="2374.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-191" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;" value="&lt;b&gt;keycloak&lt;/b&gt;&lt;br&gt;realm, users,&lt;br&gt;clients, sessions" vertex="1">
          <mxGeometry height="90" width="210" x="1969" y="2374.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-192" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;" value="&lt;b&gt;inventory&lt;/b&gt;&lt;br&gt;Axon JPA event store&lt;br&gt;+ product/stock read model&lt;br&gt;+ reservation view" vertex="1">
          <mxGeometry height="90" width="220" x="2214" y="2374.999951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-193" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;——→  synchronous REST / JDBC&lt;br&gt;①…⑥  the numbered orders → inventory&lt;br&gt;       calls, listed on the right&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;- - -→&lt;/font&gt;  asynchronous Kafka message&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;——→&lt;/font&gt;  Axon command, in-process command bus&lt;br&gt;——→  domain event on the Axon event bus&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;- - -→&lt;/font&gt;  service discovery&lt;br&gt;·····→  auth: token issue / JWKS&lt;br&gt;&lt;br&gt;A command is always &lt;i&gt;within&lt;/i&gt; one service.&lt;br&gt;What crosses a service boundary is&lt;br&gt;either a Kafka event or a REST call.&lt;br&gt;&lt;br&gt;All containers share the Docker&lt;br&gt;bridge network `app-network`." vertex="1">
          <mxGeometry height="260" width="220" x="1404" y="1692.199951171875" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-194" edge="1" parent="1" source="Kex4wcxGBSkoDXFyb8dY-172" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" target="Kex4wcxGBSkoDXFyb8dY-176" value="HTTPS / REST">
