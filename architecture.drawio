        <mxCell id="p3-orders_45" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="443" y="1056" width="367" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_46" value="Reactions to the other context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#6B4C7A;" vertex="1" parent="1">
          <mxGeometry x="860" y="130" width="820" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_47" value="StockLifecycleEventHandler&lt;br&gt;&lt;br&gt;on stock.confirmed        → ApproveOrderForConfirmedStockCommand&lt;br&gt;on stock.reservation.released (WITHDRAWN_BY_INVENTORY)&lt;br&gt;on stock.returned          → RejectOrderForWithdrawnStockCommand(detail)&lt;br&gt;A release the order itself caused is ignored — it is our own decision coming back." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="166" width="820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_48" value="ProductDeactivatedEventHandler&lt;br&gt;&lt;br&gt;on product.deactivated → find PENDING orders holding that product →&lt;br&gt;RejectOrderCommand for each. A product withdrawn cannot be sold." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="266" width="820" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_49" value="GenerateInvoiceCommandHandler  ·  not a plain @CommandHandler&lt;br&gt;&lt;br&gt;Re-checks with inventory that the order&#39;s goods are still held before the aggregate&lt;br&gt;issues the invoice — the one command that must reach outside the boundary, so it&lt;br&gt;lives outside the aggregate rather than inside it." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="342" width="820" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_50" value="Outbound synchronous  ·  InventoryClient (Feign)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3366A0;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#3366A0;" vertex="1" parent="1">
          <mxGeometry x="860" y="442" width="820" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_51" value="getProduct(id) · getStock(id)   — price and availability at placement" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#3366A0;fontSize=11;align=left;spacingLeft=8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="478" width="820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_52" value="createReservation(orderRef, lines)   — take the goods now" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#3366A0;fontSize=11;align=left;spacingLeft=8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="520" width="820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_53" value="amendReservation(orderRef) · releaseReservation(orderRef)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#3366A0;fontSize=11;align=left;spacingLeft=8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="562" width="820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_54" value="getReservation(orderRef)   — the invoice-time re-check" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#3366A0;fontSize=11;align=left;spacingLeft=8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="604" width="820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_55" value="Resilience: circuit breaker + InventoryClientFallback. BearerTokenInterceptor carries the&lt;br&gt;service token; CorrelationIdInterceptor carries the correlation id across the hop." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFE0;strokeColor=#CCCC66;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="646" width="820" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_56" value="Read models  ·  projections" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#4D7A33;" vertex="1" parent="1">
          <mxGeometry x="860" y="720" width="820" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_57" value="OrderView (+ items) — updated from the order&#39;s own events" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="756" width="820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_58" value="InvoiceView (+ line items)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="798" width="820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_59" value="TransactionView — payments and their reversals" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="840" width="820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_60" value="Why approval is not an administrator&#39;s action&lt;br&gt;&lt;br&gt;There is no ApproveOrderCommand an operator can send. Approval means the goods behind the&lt;br&gt;order have actually left the warehouse, and only inventory knows that — so the only path to&lt;br&gt;APPROVED is stock.confirmed arriving. An approval this service granted on its own would be a&lt;br&gt;promise made against a hold inventory might release the next moment.&lt;br&gt;&lt;br&gt;Rejection is split for the same reason: RejectOrderCommand refuses something still pending;&lt;br&gt;RejectOrderForWithdrawnStockCommand arrives after the fact about an order that may already&lt;br&gt;be approved, so it must not be bound by the pending rule." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFE0;strokeColor=#CCCC66;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="900" width="820" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_61" value="Order state machine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1720" y="130" width="740" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_62" value="(placed)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1960" y="176" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_63" value="PENDING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1960" y="260" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_64" value="APPROVED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1960" y="380" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_65" value="REJECTED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1730" y="380" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_66" value="CANCELLED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2200" y="500" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_67" value="CreateOrder + reservation taken" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#444444;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-orders_62" target="p3-orders_63">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_68" value="RejectOrder · product.deactivated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#444444;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-orders_63" target="p3-orders_65">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_69" value="stock.confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#444444;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-orders_63" target="p3-orders_64">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_70" value="CancelOrder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#444444;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-orders_64" target="p3-orders_66">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_71" value="stock withdrawn&lt;br&gt;(only if no money against it)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#444444;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3-orders_64" target="p3-orders_65">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_72" value="Invoicing is orthogonal to status: an APPROVED order may be invoiced&lt;br&gt;(invoice.generated) and that invoice later reversed (invoice.reversed).&lt;br&gt;Each of REJECTED, CANCELLED and a reversed invoice also publishes&lt;br&gt;order.nullified with the matching reason, which is the single event&lt;br&gt;inventory listens to in order to give the goods back." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFE0;strokeColor=#CCCC66;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1730" y="560" width="700" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_73" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="1130" width="250" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_74" value="Aggregate / entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="1166" width="230" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_75" value="Command (action)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1196" width="230" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_76" value="Domain event (internal)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1226" width="230" height="24" as="geometry" />
