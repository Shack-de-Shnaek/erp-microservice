        <mxCell id="Kex4wcxGBSkoDXFyb8dY-210" edge="1" parent="1" source="Kex4wcxGBSkoDXFyb8dY-178" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;strokeColor=#333333;strokeWidth=2;" target="Kex4wcxGBSkoDXFyb8dY-179" value="③ POST">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-211" edge="1" parent="1" source="Kex4wcxGBSkoDXFyb8dY-178" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.54;exitDx=0;exitDy=0;entryX=0;entryY=0.54;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;strokeColor=#333333;strokeWidth=2;" target="Kex4wcxGBSkoDXFyb8dY-179" value="④ PUT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-212" edge="1" parent="1" source="Kex4wcxGBSkoDXFyb8dY-178" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.68;exitDx=0;exitDy=0;entryX=0;entryY=0.68;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;strokeColor=#333333;strokeWidth=2;" target="Kex4wcxGBSkoDXFyb8dY-179" value="⑤ GET">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-213" edge="1" parent="1" source="Kex4wcxGBSkoDXFyb8dY-178" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.82;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;strokeColor=#333333;strokeWidth=2;dashed=1;" target="Kex4wcxGBSkoDXFyb8dY-179" value="⑥ DEL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Kex4wcxGBSkoDXFyb8dY-214" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=8;fontSize=11;" value="&lt;b&gt;Cross-service REST&amp;nbsp;—&amp;nbsp;orders → inventory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;`@FeignClient(name = &quot;inventory&quot;)` + Resilience4j (circuit breaker &amp;amp; fallback factory), resolved through &lt;b&gt;Consul&lt;/b&gt; by service name rather than host. Each call carries the `erp-orders` client-credentials Bearer token and the caller&#39;s correlation id. &lt;b&gt;Not routed through the gateway&lt;/b&gt;&amp;nbsp;—&amp;nbsp;the gateway is the way in from outside, not the way between.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;No Axon command crosses a service boundary.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;`axon.axonserver.enabled=false` in both services, and orders excludes `axon-server-connector` outright, so each has its own in-process command bus and neither can address the other&#39;s. What crosses is an &lt;b&gt;HTTP request&lt;/b&gt;; inventory turns it into a command &lt;i&gt;of its own&lt;/i&gt; on arrival. ③&amp;nbsp;④&amp;nbsp;⑥ are commands in intent, and &lt;/font&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#82b366&quot;&gt;the green line under each&lt;/font&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; is the command it actually dispatches.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;①&lt;/b&gt;&amp;nbsp;`GET /api/products/{productId}`&lt;br&gt;&lt;b&gt;②&lt;/b&gt;&amp;nbsp;`GET /api/stock/{productId}`&lt;br&gt;&lt;b&gt;③&lt;/b&gt;&amp;nbsp;`POST /api/reservations`&amp;nbsp;&amp;nbsp;{orderRef, lines[]}&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#82b366&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ &lt;b&gt;ReserveStockCommand&lt;/b&gt;(stockItemId, orderRef, qty)&amp;nbsp;—&amp;nbsp;one per line&lt;/font&gt;&lt;br&gt;&lt;b&gt;④&lt;/b&gt;&amp;nbsp;`PUT /api/reservations/{orderRef}`&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#82b366&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ &lt;b&gt;ReserveStockCommand&lt;/b&gt; (new line) · &lt;b&gt;AmendReservationCommand&lt;/b&gt; (changed line) · &lt;b&gt;ReleaseReservationCommand&lt;/b&gt; (dropped line)&lt;/font&gt;&lt;br&gt;&lt;b&gt;⑤&lt;/b&gt;&amp;nbsp;`GET /api/reservations/{orderRef}`&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#82b366&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ &lt;b&gt;FindReservationByOrderRefQuery&lt;/b&gt; (Axon query, read model)&lt;/font&gt;&lt;br&gt;&lt;b&gt;⑥&lt;/b&gt;&amp;nbsp;`DELETE /api/reservations/{orderRef}`&amp;nbsp;&amp;nbsp;&lt;i&gt;(compensation)&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#82b366&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ &lt;b&gt;ReleaseReservationCommand&lt;/b&gt;(…, WITHDRAWN_BY_INVENTORY)&amp;nbsp;—&amp;nbsp;one per line&lt;/font&gt;&lt;br&gt;&lt;b&gt;Not called by orders:&lt;/b&gt;&amp;nbsp;`POST /api/reservations/{orderRef}/confirm`&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#82b366&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ &lt;b&gt;ConfirmStockCommand&lt;/b&gt;&amp;nbsp;—&amp;nbsp;one per line&lt;/font&gt;" vertex="1">
          <mxGeometry height="372.8" width="470" x="2600" y="1462.2" as="geometry" />
        </mxCell>
