        <mxCell id="p2-inventory_61" value="Policies, sagas &amp; projections" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#6B4C7A;" vertex="1" parent="1">
          <mxGeometry x="1600" y="130" width="840" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_62" value="ActiveProductReservationPolicy  ·  command interceptor&lt;br&gt;&lt;br&gt;Sits on the command bus, so it sees every ReserveStockCommand and&lt;br&gt;AmendReservationCommand whatever dispatched them. Refuses a hold — or a raise of&lt;br&gt;one — against an INACTIVE product. Cross-aggregate rule: it belongs between&lt;br&gt;Product and StockItem, not inside either." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="166" width="840" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_63" value="OrderLifecycleSaga  ·  process manager&lt;br&gt;&lt;br&gt;on order.nullified (cancelled | rejected | refunded):&lt;br&gt;   look up ReservationView by orderRef  →  for each reserved line&lt;br&gt;   send ReleaseReservationCommand(stockItemId, orderRef, ORDER_NULLIFIED)&lt;br&gt;&lt;br&gt;Releases what was actually taken, from this service&#39;s own record — not from the&lt;br&gt;message. No reservation is a normal outcome; releasing twice is a no-op." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="280" width="840" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_64" value="Read models  ·  projections" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#4D7A33;" vertex="1" parent="1">
          <mxGeometry x="1600" y="410" width="840" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_65" value="ProductProjection → ProductView  (product_view)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="446" width="840" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_66" value="StockItemProjection → StockItemView  (stock_item_view)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="488" width="840" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_67" value="ReservationProjection → ReservationView  (keyed by orderRef)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1600" y="530" width="840" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_68" value="Inbound / outbound" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1600" y="590" width="840" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_69" value="IN  · KafkaEventConsumer  order.nullified → OrderEventTranslator → NullifiedOrder&lt;br&gt;IN  · REST from orders   POST/PUT/DELETE /api/reservations  (service account, JWT)&lt;br&gt;OUT · KafkaMessagingRepositoryImpl publishes every event that overrides toExternalEvent()&lt;br&gt;OUT · ReleaseReason distinguishes ORDER_NULLIFIED (an echo of the order&#39;s own decision)&lt;br&gt;      from WITHDRAWN_BY_INVENTORY (news the order has to act on)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFE0;strokeColor=#CCCC66;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1600" y="626" width="840" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_70" value="Why a reservation is not an aggregate&lt;br&gt;&lt;br&gt;The hold lives on the StockItem that owns the goods — reservationLedger[orderRef] — because&lt;br&gt;that is where the invariant reserved ≤ onHand has to hold. ReservationView is the read-side&lt;br&gt;assembly across stock items for one order, which is what the saga and the REST API need.&lt;br&gt;orderRef is a plain string: a reference into another context, deliberately not a typed&lt;br&gt;OrderId, because this context knows nothing about what an order is." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFE0;strokeColor=#CCCC66;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1600" y="726" width="840" height="122" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_71" value="rejects ReserveStock / AmendReservation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-inventory_62" target="p2-inventory_26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-inventory_72" value="reads ProductStatus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;exitDx=0;exitDy=0;" edge="1" parent="1" source="p2-inventory_62" target="p2-inventory_4">
