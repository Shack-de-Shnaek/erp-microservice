        <mxCell id="Kex4wcxGBSkoDXFyb8dY-173" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;curl / test-scripts&lt;/b&gt;&lt;br&gt;REST + Bearer token&lt;br&gt;(no SPA in this repo)" vertex="1">
