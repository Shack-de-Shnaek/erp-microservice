              <mxPoint x="300" y="1190"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e21" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;strokeColor=#b85450;" edge="1" parent="1" source="inventory" target="dbInventory">
          <mxGeometry relative="1" as="geometry">
