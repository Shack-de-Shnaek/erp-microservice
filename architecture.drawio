          <mxGeometry x="70" y="1346" width="230" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_81" value="REST endpoint / actor" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#3366A0;fontSize=11;align=left;spacingLeft=8;dashed=0;" vertex="1" parent="1">
