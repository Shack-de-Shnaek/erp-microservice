        <mxCell id="p4-flow_79" value="ProductDeactivatedEventHandler&lt;br&gt;→ RejectOrderCommand for PENDING orders" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
