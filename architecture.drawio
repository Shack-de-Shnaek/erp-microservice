        <mxCell id="p3-orders_1" value="Orders context — inside the boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="24" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_2" value="One aggregate root. Invoice and Transaction are entities inside it, not aggregates of their own: an invoice must total exactly what the order holds, and money paid must reconcile against it." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="50" y="62" width="1500" height="34" as="geometry" />
