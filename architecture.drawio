          <mxGeometry x="60" y="130" width="760" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p3-orders_4" value="Order  ·  aggregate root  ·  OrderId&lt;br&gt;customerId (Keycloak subject), CustomerName, OrderStatus, totalAmount&lt;br&gt;Invariants: only a PENDING order may be edited or rejected · an order with money&lt;br&gt;against it may not be closed by withdrawn stock · an invoice totals the order&#39;s items" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="166" width="760" height="78" as="geometry" />
        </mxCell>
