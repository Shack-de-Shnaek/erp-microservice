{
  "realm": "erp",
  "displayName": "ERP",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 7200,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "May reject orders and manage the catalogue and its stock. Maps to ROLE_ADMIN via the realm_access.roles claim."
      },
      {
        "name": "CUSTOMER",
        "description": "May place, read and cancel their own orders."
      },
      {
        "name": "SERVICE",
        "description": "A service acting on its own behalf rather than a user's. Held by service accounts only; what inventory's reservation and stock-reserve endpoints accept from a caller with no customer behind it."
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "ERP",
      "lastName": "Administrator",
      "email": "admin@erp.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "CUSTOMER"]
    },
    {
      "username": "customer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sample",
      "lastName": "Customer",
      "email": "customer@erp.local",
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "service-account-erp-mcp",
      "enabled": true,
      "serviceAccountClientId": "erp-mcp",
      "realmRoles": ["ADMIN", "CUSTOMER"]
    },
    {
      "username": "service-account-erp-orders",
      "enabled": true,
      "serviceAccountClientId": "erp-orders",
      "realmRoles": ["SERVICE"]
    }
  ],
  "clients": [
    {
      "clientId": "erp-gateway",
      "name": "API Gateway (browser login)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "erp-gateway-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8088/login/oauth2/code/keycloak",
        "http://localhost:8088/*"
      ],
      "webOrigins": ["http://localhost:8088"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8088/*"
      }
    },
    {
      "clientId": "erp-mcp",
      "name": "MCP server (service account)",
      "description": "Confidential client for the MCP server. Service accounts only: no user behind it, so it uses the client-credentials grant and never a login. Its account holds ADMIN and CUSTOMER, which is what lets the write tools place an order.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "erp-mcp-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "erp-orders",
      "name": "Orders service (service account)",
      "description": "Confidential client for the orders service, used only when it calls inventory with no user behind the call and so no token to relay. Its account holds SERVICE and nothing else: it can take and give back stock, and cannot touch the catalogue.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "erp-orders-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}
